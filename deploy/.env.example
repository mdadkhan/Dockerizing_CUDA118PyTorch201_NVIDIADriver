# AI-CAC configuration template.
# Copy to .env and fill in. .env is git-ignored and is never copied into the image;
# pass it at run time with: podman run --env-file .env ...

# ========================================
# S3 storage
# ========================================
# The bucket must stay private (S3 Block Public Access on). Masks are served through
# short-lived presigned URLs, never public object URLs.
USE_S3_STORAGE=false
S3_BUCKET_NAME=
AWS_REGION=us-east-1
S3_PREFIX=RADFLOW/outputs/ai-cac-outputs
# Presigned URL lifetime in seconds
S3_URL_EXPIRATION=3600
# Delete the local copy of masks after they are uploaded to S3
S3_CLEANUP_LOCAL=true

# ========================================
# AWS credentials
# ========================================
# Recommended: no keys here. Use an IAM role (EC2 instance profile, ECS task role)
# or another short-lived credential source.
# Static keys only as a last resort, scoped to this bucket/prefix, and never committed.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ========================================
# Model
# ========================================
MODEL_CHECKPOINT_FILE=model/va_non_gated_ai_cac_model.pth
# SHA-256 the weights must match before they are loaded
MODEL_SHA256=cfded8253e64b81b963a314cb5adc90d30a1f21574638366b80c783676c1733d
INFERENCE_BATCH_SIZE=16
# DataLoader worker processes (0 = single-threaded)
DATALOADER_NUM_WORKERS=4

# ========================================
# Uploads (zip-bomb protection)
# ========================================
MAX_UPLOAD_MB=1024
MAX_UNCOMPRESSED_MB=4096
MAX_ZIP_FILES=10000

# ========================================
# PHI retention
# ========================================
# Uploaded zips and extracted DICOMs are always deleted after each request.
# Hours to keep local masks and debug CSVs (0 = keep until removed by hand).
OUTPUT_RETENTION_HOURS=24
# Write the DICOM metadata debug CSVs (contain study metadata and file paths)
WRITE_DEBUG_CSVS=false

# ========================================
# Local development only (python app.py)
# ========================================
# The container runs gunicorn and ignores these. Debug mode binds to 127.0.0.1 only.
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=25000
